{
    "name": "@gsknnft/skill-ledger",
    "version": "0.1.0",
    "description": "Manifest, inventory, and doctor utilities for agent SKILL.md installations.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "skill-ledger": "./dist/cli.js",
        "skill-ledger-doctor": "./dist/cli-doctor.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./doctor": {
            "types": "./dist/commands/doctor.d.ts",
            "import": "./dist/commands/doctor.js",
            "default": "./dist/commands/doctor.js"
        },
        "./manifest": {
            "types": "./dist/registry/manifester.d.ts",
            "import": "./dist/registry/manifester.js",
            "default": "./dist/registry/manifester.js"
        },
        "./build": {
            "types": "./dist/commands/add.d.ts",
            "import": "./dist/commands/add.js",
            "default": "./dist/commands/add.js"
        },
        "./list": {
            "types": "./dist/commands/list.d.ts",
            "import": "./dist/commands/list.js",
            "default": "./dist/commands/list.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "LICENSE",
        "package.json"
    ],
    "scripts": {
        "build": "pnpm clean && tsc -p tsconfig.json",
        "test": "vitest run",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "example:doctor": "pnpm build && node dist/cli-doctor.js manifest.json",
        "example:list": "pnpm build && node dist/cli.js list manifest.json --markdown",
        "example:validate": "pnpm build && node dist/cli.js validate-manifest manifest.json",
        "pack:check": "pnpm pack --dry-run"
    },
    "dependencies": {},
    "devDependencies": {
        "vitest": "4.1.5",
        "typescript": "5.9.3"
    },
    "author": "@gsknnft",
    "license": "MIT",
    "peerDependencies": {
        "@gsknnft/skill-safe": "^0.2.1"
    }
}
